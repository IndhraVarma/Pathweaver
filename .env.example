# Server configuration. Copy to .env and adjust; every value below is the
# built-in default. The client has its own template at client/.env.example.

# HTTP
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed browser origins.
# Leave unset when the client is served from this same service (same-origin).
# REQUIRED when the client is hosted separately, e.g. on Vercel — list the
# production domain, plus any preview domains you want to work:
# CORS_ORIGIN=https://pathweaver.vercel.app,https://pathweaver-git-main-you.vercel.app

# Number of proxy hops to trust for the client IP (Render/Fly/Heroku: 1).
TRUST_PROXY=1

# Where scenarios and run statistics are written. Use a mounted volume in
# production so saved boards survive a redeploy.
DATA_FILE=./server/data/store.json

# Request body ceiling. A 200x200 board of walls stays well under this.
BODY_LIMIT=2mb

# Fixed-window rate limiting, applied per IP across /api.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# debug | info | warn | error | silent, and pretty | json
LOG_LEVEL=info
LOG_FORMAT=json

# Shown by GET /api/health.
APP_VERSION=1.0.0
