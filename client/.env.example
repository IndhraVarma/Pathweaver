# Client build-time configuration (Vite).
#
# Vite inlines VITE_* variables into the bundle AT BUILD TIME, so changing
# this on the host requires a redeploy, not just a restart.

# Absolute base URL of the API, including the /api suffix.
# Leave unset when the client and API are served from the same origin —
# it then defaults to the relative path /api.
# VITE_API_BASE=https://pathweaver-api.onrender.com/api
