{
  "name": "pathfinding-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive pathfinding algorithm visualizer with a Node/Express API and a React client.",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "heroku-postbuild": "npm run build",
    "preview": "npm run build && npm start",
    "test": "node --test",
    "lint": "node --check server/src/index.js && node --check shared/algorithms.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
